# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Groq (STT + AI + TTS all run through this one key)
GROQ_API_KEY=

# Speech-to-text (Groq Whisper)
STT_MODEL=whisper-large-v3-turbo

# AI model (Groq chat completion)
AI_MODEL=openai/gpt-oss-20b

# Text-to-speech (Groq TTS)
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn
TTS_FORMAT=mp3
TTS_MP3_BITRATE=64

# Training-data fuzzy-match threshold (0.0 - 1.0)
TRAINING_MATCH_THRESHOLD=0.72

# WebSocket limits (bytes / seconds)
MAX_AUDIO_SIZE_BYTES=16777216
MAX_WS_FRAME_BYTES=4194304
MAX_AUDIO_DURATION_SECONDS=600
RESPONSE_CHUNK_SIZE=16384
HEARTBEAT_INTERVAL_SECONDS=30
IDENTIFICATION_TIMEOUT_SECONDS=30
